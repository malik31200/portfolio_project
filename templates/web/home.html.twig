{% extends 'base.html.twig' %}

{% block title %}Accueil - Actual Sport{% endblock %}

{% block body %}
<div class="hero">
    <div class="hero-content">
        <h1>Bienvenue chez Actual Sport</h1>
        <p>Votre salle de sport.</p>
        <div class="hero-buttons">
            <a href="{{ path('app_courses') }}" class="btn btn-primary">Découvrir les cours</a>
            <a href="{{ path('app_sessions') }}" class="btn btn-outline">Voir les sessions</a>
        </div>
    </div>
</div>

{% if courses is empty %}
    <p>Aucun cours disponible.</p>
{% else %}
    <h2>Nos cours :</h2>
    <div class="grid">
        {% for course in courses %}
            <div class="card">
                <h3>{{ course.name }}</h3>
                <p>{{ course.description }}</p>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}